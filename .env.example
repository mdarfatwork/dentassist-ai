# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DB_URL=postgresql://user:password@host/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Calendar Integration (Dedicated Calendar OAuth)
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=32_byte_hex_or_base64_encryption_key

# Resend Email Delivery
RESEND_API_KEY=re_your_resend_api_key

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=assets

# Pinecone Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=dentassist
PINECONE_NAMESPACE_PREFIX=

# Three LLM Provider Failover & Circuit Breaker Configuration
# Provider 1: Google Gemini (Primary)
AI_PROVIDER_1=gemini
AI_MODEL_1=gemini-2.5-flash-lite
AI_PRIORITY_1=1
GEMINI_API_KEY=your-gemini-api-key

# Provider 2: Groq (Secondary)
AI_PROVIDER_2=groq
AI_MODEL_2=openai/gpt-oss-20b
AI_PRIORITY_2=2
GROQ_API_KEY=your-groq-api-key

# Provider 3: OpenRouter (Tertiary)
AI_PROVIDER_3=openrouter
AI_MODEL_3=google/gemma-4-31b-it:free
AI_PRIORITY_3=3
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Circuit Breaker & Failover Settings
AI_REQUEST_TIMEOUT_MS=15000
AI_PROVIDER_COOLDOWN_MS=60000
AI_RATE_LIMIT_COOLDOWN_MS=60000
AI_TIMEOUT_COOLDOWN_MS=30000
AI_PROVIDER_ERROR_COOLDOWN_MS=30000
AI_NETWORK_ERROR_COOLDOWN_MS=30000
AI_INVALID_OUTPUT_COOLDOWN_MS=30000
AI_AUTH_ERROR_COOLDOWN_MS=600000
AI_CONFIG_ERROR_COOLDOWN_MS=600000
AI_FAILURE_THRESHOLD=1

# NVIDIA NIM Prompt Guard (Preserved for prompt guard)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PROMPT_GUARD_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Embeddings & RAG Ingestion
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL=multilingual-e5-large
MAX_KNOWLEDGE_FILE_SIZE=10485760
RAG_TOP_K=5
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80