{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "daemons": {
    "whatsapp-worker": {
      "root": ".",
      "entrypoint": "Dockerfile.daemon",
      "instances": {
        "iad1": 1
      },
      "resources": {
